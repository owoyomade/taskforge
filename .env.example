# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# Base URL of this app. Used to build links in auth emails.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase API URL. Local value is printed by `npm run db:start`
# (shown as "API URL" / "Project URL"). Hosted: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable (anon) key. Safe to expose to the browser because
# Row Level Security decides what each signed-in user can read and write.
# Local value is printed by `npm run db:start` as "Publishable key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Taskforge does not use the Supabase secret (service role) key at all:
# every query runs as the signed-in user, under Row Level Security. If a
# future feature needs it, it must only ever be read by server code and
# must never be prefixed with NEXT_PUBLIC_.
