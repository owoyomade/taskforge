# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# Base URL of this app. Used to build links in auth emails.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -----------------------------------------------------
# Local values match docker-compose.yml. In production, use your Neon
# connection strings with strong passwords, then run `npm run db:roles`.
#
# Owner login: used only by `npm run db:migrate` / `db:roles`, never by the app.
DATABASE_OWNER_URL=postgres://postgres:postgres@127.0.0.1:5433/taskforge
# The app's login. It has no table access until it names the signed-in user.
DATABASE_URL=postgres://taskforge_app:taskforge_app@127.0.0.1:5433/taskforge
# The sign-in library's login. It can reach the auth tables only.
DATABASE_AUTH_URL=postgres://taskforge_auth:taskforge_auth@127.0.0.1:5433/taskforge

# --- Sign-in --------------------------------------------------------------------
# Signs session cookies. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Email ----------------------------------------------------------------------
# Local: Mailpit from docker-compose.yml (no login needed; see http://127.0.0.1:8025).
# Production with Gmail: smtp.gmail.com, port 465, your address, and an app
# password (Google account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Taskforge <no-reply@taskforge.local>

# --- Demo (optional) -------------------------------------------------------------
# Turns on the "Try the demo" button, which signs visitors in to a shared sample
# workspace that resets every night. Visitors never see this password. Use 16+
# random characters (same command as BETTER_AUTH_SECRET). Leave empty to hide it.
DEMO_PASSWORD=

# --- Scheduled job ---------------------------------------------------------------
# Vercel sends this with its daily call to /api/cron/purge. Any random value.
CRON_SECRET=

